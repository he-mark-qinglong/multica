              .attr("data-project",  d => d.data.project_id || "")
              .attr("data-project-name", d => d.data.project_name || "no_project")
              .on("mouseover", function(ev, d) {
                 d3.select(this).classed("highlight", true);
                 const tip = d3.select("#tip");
                 const m = d.data.multica_id
                   ? `<a class="btn" href="${MULTICA_BASE}/issues/${d.data.multica_id}" target="_blank">open multica ↗</a>`
                   : "";
                 const tags = (d.data.tags || []).slice(0, 12);
                 const tagHtml = tags.length
                   ? `<div class="tags">${tags.map(t => {
                        const cls = tagPillClass(t);
                        return `<span class="pill ${cls}">${escapeHtml(t)}</span>`;
                      }).join("")}</div>`
                   : "";
                 const labelsHtml = (d.data.labels && d.data.labels.length)
                   ? `<div class="row"><span class="badge">labels: ${d.data.labels.map(escapeHtml).join(", ")}</span></div>`
                   : "";
                 tip.html(
                   `<b>${escapeHtml(d.data.name || "")}</b>` +
                   `<div class="row">` +
                     `<span class="badge status-${d.data.status || "unknown"}"><span class="dot"></span>${escapeHtml(d.data.status || "unknown")}</span>` +
