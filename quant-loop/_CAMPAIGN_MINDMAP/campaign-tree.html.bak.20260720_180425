const root = d3.hierarchy(DATA).sum(d => d.value || 0).sort((a, b) => b.value - a.value);
const W = document.getElementById("viz").clientWidth;
const H = document.getElementById("viz").clientHeight;
const R = Math.min(W, H) / 2 - 16;
const svg = d3.select("#main-svg").attr("viewBox", [-W / 2, -H / 2, W, H]);
const g = svg.append("g");
const partition = d3.partition().size([2 * Math.PI, R]);
partition(root);
const arc = d3.arc().startAngle(d => d.x0).endAngle(d => d.x1)
              .padAngle(d => Math.min((d.x1 - d.x0) / 2, 0.005))
              .padRadius(R / 2).innerRadius(d => d.y0).outerRadius(d => d.y1 - 1);
