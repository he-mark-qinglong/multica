", "multica_id": "", "description": "1 meta commits", "children": [{"name": "docs(campaign-tree): add visual sunburst+mindmap of all VPVR/XS/BB campaigns", "status": "info", "multica_id": "", "description": "b4690d08 · 2026-07-11 22:20:47 +0800 · docs(campaign-tree): add visual sunburst+mindmap of all VPVR/XS/BB campaigns", "value": 1}]}]};
const root = d3.hierarchy(DATA).sum(d => d.value || 0).sort((a,b) => b.value - a.value);
const W = document.getElementById("viz").clientWidth;
const H = document.getElementById("viz").clientHeight;
const R = Math.min(W, H) / 2 - 8;
const svg = d3.select("#main-svg").attr("viewBox", [-W/2, -H/2, W, H]);
const g = svg.append("g");
const partition = d3.partition().size([2*Math.PI, R]);
partition(root);
const arc = d3.arc().startAngle(d => d.x0).endAngle(d => d.x1)
              .padAngle(d => Math.min((d.x1-d.x0)/2, 0.005))
              .padRadius(R/2).innerRadius(d => d.y0).outerRadius(d => d.y1-1);
const path = g.selectAll("path").data(root.descendants()).join("path")
              .attr("d", arc).attr("class","arc")
              .attr("fill", d => STATUS_COLOR[d.data.status] || STATUS_COLOR.info)
              .attr("data-status", d => d.data.status)
              .on("mouseover", function(ev, d) {
                 d3.select(this).classed("highlight", true);
                 const tip = d3.select("#tip");
                 const m = d.data.multica_id ? `<a class="btn" href="${MULTICA_BASE}/issues/${d.data.multica_id}" target="_blank">open multica ↗</a>` : "";
                 tip.html(`<b>${d.data.name}</b><br>${d.data.description || ""}${m ? "<br>"+m : ""}`)
                    .style("left", (ev.offsetX+12)+"px").style("top",(ev.offsetY+12)+"px")
                    .style("opacity",1);
              })
              .on("mousemove", function(ev) {
                 d3.select("#tip").style("left",(ev.offsetX+12)+"px").style("top",(ev.offsetY+12)+"px");
              })
              .on("mouseout", function() {
                 d3.select(this).classed("highlight", false);
                 d3.select("#tip").style("opacity",0);
              })
              .on("click", function(ev, d) {
                 if (d.data.multica_id) window.open(`${MULTICA_BASE}/issues/${d.data.multica_id}`, "_blank");
              });
g.append("text").attr("class","center-label").attr("text-anchor","middle")
 .text(DATA.name);
g.append("text").attr("class","center-sub").attr("text-anchor","middle").attr("dy",18)
 .text(`${root.value} campaign commits · 2026-07-20T00:05:25+08:00`);
</script>
</body>
</html>
