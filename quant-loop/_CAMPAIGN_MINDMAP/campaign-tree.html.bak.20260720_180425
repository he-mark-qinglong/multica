// ----- helpers -----
function statusColor(s) { return STATUS_COLOR[s] || STATUS_FALLBACK; }
function priorityRing(p) { return (p && PRIORITY_RING[p]) || PRIORITY_FALLBACK; }
function phaseColor(p)   { return PHASE_BADGE_COLOR[p] || "#888"; }
function escapeHtml(s) {
  return String(s == null ? "" : s)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
}
function tagPillClass(tag) {
  const t = tag.toLowerCase();
  if (t.startsWith("kill") || t.includes("killed") || t.includes("cancelled")) return "kill";
  if (t.includes("framework") || t.includes("validated")) return "framework";
  if (t.includes("ship-gate") || t.includes("ship_gate") || t.includes("verdict")) return "ship-gate";
  return "";
}

