              });

// Priority rings (outer ring just outside the leaf arc).
const rings = g.selectAll("path.arc-ring").data(root.descendants().filter(d => priorityRing(d.data.priority)))
              .join("path")
              .attr("class", "arc-ring")
              .attr("d", ringArc)
              .attr("stroke", d => priorityRing(d.data.priority).color)
              .attr("stroke-width", d => priorityRing(d.data.priority).width)
              .attr("fill", "none")
              .attr("data-status",   d => d.data.status || "unknown")
              .attr("data-priority", d => d.data.priority || "none")
              .attr("data-phase",    d => d.data.phase || "proposed")
              .attr("data-project",  d => d.data.project_id || "")
              .attr("data-project-name", d => d.data.project_name || "no_project");

// Center labels.
g.append("text").attr("class", "center-label").attr("text-anchor", "middle")
 .text(DATA.name);
g.append("text").attr("class", "center-sub").attr("text-anchor", "middle").attr("dy", 18)
 .text(`${root.value} campaign commits · ${DATA.description ? "" : ""}`);

// ----- filters -----
const state = { status: "__any__", priority: "__any__", project: "__any__" };

function applyFilters() {
  const s = state.status, p = state.priority, pr = state.project;
  const match = (d) =>
    (s === "__any__" || (d.data.status || "unknown") === s) &&
    (p === "__any__" || (d.data.priority || "none") === p) &&
    (pr === "__any__" || (d.data.project_id || "") === pr);
  arcs.classed("dimmed", d => !match(d));
  rings.classed("dimmed", d => !match(d));
}

document.querySelectorAll("#filters .group").forEach(group => {
  const facet = group.dataset.facet;
  const pop = document.getElementById("pop-" + facet);
  const allBtn = group.querySelector('button[data-pick="__any__"]');
  allBtn.addEventListener("click", () => {
    state[facet] = "__any__";
    group.querySelectorAll("button[data-pick]").forEach(b => b.classList.remove("active"));
    allBtn.classList.add("active");
    pop.querySelectorAll(".chip").forEach(c => c.classList.remove("on"));
    applyFilters();
  });
  // Build the popover lazily after we know what values exist.
  group._pop = pop;
});

document.getElementById("filter-clear").addEventListener("click", () => {
  state.status = state.priority = state.project = "__any__";
  document.querySelectorAll("#filters .group").forEach(g => {
    g.querySelectorAll("button[data-pick]").forEach(b => b.classList.remove("active"));
    const all = g.querySelector('button[data-pick="__any__"]');
    if (all) all.classList.add("active");
    if (g._pop) g._pop.querySelectorAll(".chip").forEach(c => c.classList.remove("on"));
  });
  document.querySelectorAll("#rollups .stat").forEach(s => s.classList.remove("active"));
  applyFilters();
});

// Build faceted popovers from the data.
function buildPopovers() {
  // status
  const statuses = Array.from(new Set(root.descendants().map(d => d.data.status || "unknown")))
    .filter(s => s !== "info");
  const popS = document.getElementById("pop-status");
  statuses.sort().forEach(s => {
    const c = document.createElement("span");
    c.className = "chip"; c.dataset.pick = s;
    c.innerHTML = `<span class="dot" style="background:${statusColor(s)}"></span>${s}`;
    c.addEventListener("click", () => {
      if (state.status === s) {
        state.status = "__any__"; c.classList.remove("on");
      } else {
        state.status = s;
        popS.querySelectorAll(".chip").forEach(x => x.classList.remove("on"));
        c.classList.add("on");
      }
      // sync the inline "all" button.
      const grp = document.querySelector('#filters .group[data-facet="status"]');
      grp.querySelectorAll("button[data-pick]").forEach(b => b.classList.remove("active"));
      if (state.status === "__any__") grp.querySelector('button[data-pick="__any__"]').classList.add("active");
      applyFilters();
    });
    popS.appendChild(c);
  });

  // priority
  const prios = Array.from(new Set(root.descendants().map(d => d.data.priority || "none")));
  const popP = document.getElementById("pop-priority");
  prios.sort().forEach(p => {
    const c = document.createElement("span");
    c.className = "chip"; c.dataset.pick = p;
    const ring = priorityRing(p);
    const ringHtml = ring ? `<span class="dot" style="background:${ring.color}"></span>` : "";
    c.innerHTML = `${ringHtml}${p}`;
    c.addEventListener("click", () => {
      if (state.priority === p) {
        state.priority = "__any__"; c.classList.remove("on");
      } else {
        state.priority = p;
        popP.querySelectorAll(".chip").forEach(x => x.classList.remove("on"));
        c.classList.add("on");
      }
      const grp = document.querySelector('#filters .group[data-facet="priority"]');
      grp.querySelectorAll("button[data-pick]").forEach(b => b.classList.remove("active"));
      if (state.priority === "__any__") grp.querySelector('button[data-pick="__any__"]').classList.add("active");
      applyFilters();
    });
    popP.appendChild(c);
  });

  // project
  const projects = new Map();
  root.descendants().forEach(d => {
    const k = d.data.project_name || "no_project";
    if (!projects.has(k)) projects.set(k, d.data.project_id || "");
  });
  const popPr = document.getElementById("pop-project");
  Array.from(projects.keys()).sort().forEach(name => {
    const id = projects.get(name);
    const c = document.createElement("span");
    c.className = "chip"; c.dataset.pick = id;
    c.textContent = name;
    c.title = id;
    c.addEventListener("click", () => {
      const next = state.project === id ? "__any__" : id;
      state.project = next;
      popPr.querySelectorAll(".chip").forEach(x => x.classList.remove("on"));
      if (next !== "__any__") c.classList.add("on");
      const grp = document.querySelector('#filters .group[data-facet="project"]');
      grp.querySelectorAll("button[data-pick]").forEach(b => b.classList.remove("active"));
      if (state.project === "__any__") grp.querySelector('button[data-pick="__any__"]').classList.add("active");
      applyFilters();
    });
    popPr.appendChild(c);
  });
}
buildPopovers();

// Click on filter group header toggles its popover.
document.querySelectorAll("#filters .group").forEach(group => {
  const pop = group._pop;
  group.querySelectorAll("button[data-pick]").forEach(btn => {
    btn.addEventListener("click", e => {
      // For non-"all" buttons that aren't popover chips, also toggle popover.
      if (btn.dataset.pick === "__any__") {
        const open = pop.classList.toggle("open");
        e.stopPropagation();
        // Close other popovers.
        document.querySelectorAll("#filters .pop").forEach(p => { if (p !== pop) p.classList.remove("open"); });
      }
    });
  });
});
document.addEventListener("click", e => {
  if (!e.target.closest("#filters")) {
    document.querySelectorAll("#filters .pop").forEach(p => p.classList.remove("open"));
  }
});

// ----- rollup header -----
function renderRollups() {
  const r = ROLLUPS || {};
  const sc = r.status_counts || {};
  const pc = r.phase_counts || {};
  const prc = r.priority_counts || {};
  const totalEl = document.querySelector('#rollup-status .stat.total .n');
  if (totalEl) totalEl.textContent = String(r.total || 0);

  // Render status row chips.
  const statusRow = document.getElementById("rollup-status");
  // Remove everything except the first stat.total and the lbl.
  Array.from(statusRow.querySelectorAll('.stat:not(.total)')).forEach(n => n.remove());
  const STATUSES = ["backlog", "todo", "in_progress", "in_review", "done", "cancelled", "killed"];
  STATUSES.forEach(s => {
    const n = sc[s] || 0;
    if (!n && s !== "todo") return;       // always show "todo" even if zero
    const span = document.createElement("span");
    span.className = "stat";
    span.dataset.status = s;
    span.innerHTML = `<span class="dot"></span><span class="n">${n}</span><span class="label">${s}</span>`;
    span.addEventListener("click", () => {
      if (state.status === s) {
        state.status = "__any__"; span.classList.remove("active");
      } else {
        state.status = s;
        statusRow.querySelectorAll(".stat").forEach(x => x.classList.remove("active"));
        span.classList.add("active");
      }
      // Sync filter row buttons.
      const grp = document.querySelector('#filters .group[data-facet="status"]');
      grp.querySelectorAll("button[data-pick]").forEach(b => b.classList.remove("active"));
      if (state.status === "__any__") grp.querySelector('button[data-pick="__any__"]').classList.add("active");
      // Sync popover chips.
      const popS = document.getElementById("pop-status");
      popS.querySelectorAll(".chip").forEach(c => c.classList.toggle("on", c.dataset.pick === state.status));
      applyFilters();
    });
    statusRow.appendChild(span);
  });

  // Phases row.
  const phaseRow = document.getElementById("rollup-phase");
  phaseRow.querySelectorAll(".stat").forEach(n => n.remove());
  ["proposed", "active", "blocked", "done", "killed", "parked"].forEach(p => {
    const n = pc[p] || 0;
    if (!n && p !== "proposed") return;
    const span = document.createElement("span");
    span.className = "stat phase-stat";
    span.dataset.phase = p;
    span.innerHTML = `<span class="dot" style="background:${phaseColor(p)}"></span><span class="n">${n}</span><span class="label">${p}</span>`;
    phaseRow.appendChild(span);
  });

  // Tags row.
  const tagRow = document.getElementById("rollup-tag");
  Array.from(tagRow.querySelectorAll(".tag-chip")).forEach(n => n.remove());
  const tagEmpty = tagRow.querySelector(".empty");
  if (tagEmpty) tagEmpty.remove();
  const tags = (r.top_tags || []).slice(0, 10);
  if (!tags.length) {
    const empty = document.createElement("span");
    empty.className = "empty";
    empty.style.color = "var(--muted)";
    empty.style.fontSize = "10px";
    empty.textContent = "—";
    tagRow.appendChild(empty);
  } else {
    tags.forEach(([name, n]) => {
      const span = document.createElement("span");
      span.className = "tag-chip stat";
      const cls = tagPillClass(name);
      span.innerHTML = `<span class="pill ${cls}" style="background:rgba(255,255,255,0.04);border:1px solid var(--border);padding:1px 7px;border-radius:9px;font-size:10px">${escapeHtml(name)} <b>${n}</b></span>`;
      tagRow.appendChild(span);
    });
  }

  // Priority row is inlined elsewhere if desired; keep it under status for compactness.
  const prioLine = Object.entries(prc).filter(([k]) => k !== "none").map(([k, n]) => `${k}=${n}`).join(" · ");
  if (prioLine) {
    const span = document.createElement("span");
    span.className = "stat";
    span.style.fontSize = "10px";
    span.style.color = "var(--muted)";
    span.title = "priority distribution (excluding 'none')";
    span.textContent = "priority: " + prioLine;
    statusRow.appendChild(span);
  }
}
renderRollups();
</script>
