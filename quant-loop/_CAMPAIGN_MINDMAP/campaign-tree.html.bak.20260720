<style>
:root { --bg:#0a0e14; --fg:#f0f0f0; --muted:#c9d1d9; --accent:#58a6ff;
        --archived:#ef4444; --killed:#f59e0b; --live:#10b981; --stale:#6e7681;
        --info:#58a6ff; --border:#1f242c; --depth1:#161b22; }
* { box-sizing: border-box; }
body { font: 12px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", monospace;
       background: var(--bg); color: var(--fg); margin: 0; height: 100vh;
       display: flex; flex-direction: column; overflow: hidden; }
header { padding: 8px 12px; background: var(--depth1); border-bottom: 1px solid var(--border);
         display: flex; align-items: center; gap: 12px; flex-shrink: 0; flex-wrap: wrap; }
header h1 { font-size: 14px; font-weight: 600; margin: 0; flex-shrink: 0; }
header h1 .iter { color: var(--accent); }
header .meta { font-size: 11px; color: var(--muted); }
header .meta b { color: var(--fg); }
main { flex: 1; display: flex; overflow: hidden; min-height: 0; }
#viz { flex: 1; position: relative; background: var(--bg); overflow: hidden; }
#viz svg { width: 100%; height: 100%; display: block; }
#viz .arc { stroke: var(--bg); stroke-width: 1; cursor: pointer; transition: opacity .15s; }
#viz .arc:hover { opacity: 0.65; }
#viz .arc.dimmed { opacity: 0.18; }
#viz .arc.highlight { opacity: 1; stroke: #fff; stroke-width: 2; }
#viz .arc-text { font-size: 10px; pointer-events: none; fill: rgba(255,255,255,0.92); }
#viz .arc-text.dimmed { opacity: 0.18; }
#viz .center-label { font: 600 14px monospace; pointer-events: none; }
#viz .center-sub { font: 10px monospace; pointer-events: none; fill: var(--muted); }
#viz .tip { position: absolute; padding: 6px 8px; background: rgba(20,22,28,.96);
            border: 1px solid var(--border); border-radius: 4px; font-size: 11px;
            pointer-events: none; opacity: 0; transition: opacity .12s;
            max-width: 340px; z-index: 10; line-height: 1.5; }
#viz .tip b { color: var(--accent); }
#viz .tip a.btn { display: inline-block; margin-top: 4px; padding: 2px 8px;
                  border: 1px solid var(--accent); border-radius: 3px; font-size: 10px;
                  cursor: pointer; background: transparent; color: var(--accent); text-decoration: none; }
#viz .tip a.btn:hover { background: var(--accent); color: var(--bg); }
.legend { position: absolute; bottom: 8px; left: 8px; display: flex; gap: 3px;
         background: rgba(20,22,28,.92); padding: 4px 6px; border-radius: 5px;
         font-size: 10px; z-index: 5; border: 1px solid var(--border); }
.legend .chip { display: inline-flex; align-items: center; gap: 3px; padding: 1px 4px; }
.legend .dot { width: 8px; height: 8px; border-radius: 50%; }
.hint { position: absolute; bottom: 8px; right: 8px; padding: 4px 8px;
         background: rgba(20,22,28,.92); border: 1px solid var(--border);
         border-radius: 5px; font-size: 10px; color: var(--muted); z-index: 5; }
</style>
</head>
